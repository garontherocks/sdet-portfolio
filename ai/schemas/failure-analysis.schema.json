{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FailureAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "risk", "failureCategory", "likelyCause", "confidence", "affectedTests", "evidence", "recommendedActions"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high"] },
    "failureCategory": { "enum": ["application-regression", "test-defect", "environment", "flaky-timing", "security", "insufficient-evidence"] },
    "likelyCause": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affectedTests": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recommendedActions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
