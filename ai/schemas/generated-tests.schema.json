{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneratedTestPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirementId", "testCases", "coverageGaps"],
  "properties": {
    "requirementId": { "type": "string", "minLength": 1 },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "priority", "level", "classification", "preconditions", "steps", "expectedResult", "traceability"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "level": { "enum": ["ui", "api", "integration", "performance", "security"] },
          "classification": { "enum": ["positive", "negative", "boundary"] },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "expectedResult": { "type": "string" }, "traceability": { "type": "string" }
        }
      }
    },
    "coverageGaps": { "type": "array", "items": { "type": "string" } }
  }
}
