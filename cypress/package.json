{
  "name": "cypress-tests",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "UI and API tests for SauceDemo and ReqRes using Cypress and JavaScript.",
  "scripts": {
    "open": "cypress open",
    "run": "cypress run",
    "test:smoke": "cypress run --spec 'e2e/ui/login/login.cy.js,e2e/ui/cart/add-to-cart.cy.js'",
    "test:api": "cypress run --spec 'e2e/api/**/*.cy.js'",
    "report:merge": "mochawesome-merge reports/mochawesome/*.json -o reports/mochawesome/merged.json",
    "report:gen": "marge reports/mochawesome/merged.json -o reports/mochawesome/html",
    "percy:exec": "percy exec -- cypress run --spec e2e/ui/cart/add-to-cart.cy.js"
  },
  "author": "Víctor Martín Aller",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^16.0.0",
    "mochawesome": "^8.1.0",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
