{
  "name": "playwright-tests",
  "version": "2.0.0",
  "private": true,
  "description": "UI and API tests for SauceDemo and ReqRes using Playwright and TypeScript.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test e2e/api",
    "report:allure": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "percy:playwright": "percy exec -- playwright test e2e/ui/cart/add-to-cart.spec.ts --project=chromium"
  },
  "author": "Víctor Martín Aller",
  "license": "MIT",
  "devDependencies": {
    "@percy/cli": "^1.30.10",
    "@percy/playwright": "^1.0.8",
    "@playwright/test": "^1.51.1",
    "@types/node": "^26.5.1",
    "allure-commandline": "^2.33.0",
    "allure-playwright": "^3.2.1"
  }
}
